# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_CONTACT_EMAIL: Professional contact email displayed and used for notifications
VITE_CONTACT_EMAIL="alexsampaio2003@gmail.com"

# VITE_WHATSAPP_NUMBER: Optional international format phone number (e.g. 5511999999999) for direct WhatsApp pre-filled chat
VITE_WHATSAPP_NUMBER=""

# VITE_GITHUB_URL: Professional GitHub profile URL
VITE_GITHUB_URL="https://github.com/alexsampaio"

# VITE_FORMSPREE_ENDPOINT: Optional endpoint (e.g. https://formspree.io/f/xxxxxx) for static hosting on GitHub Pages
VITE_FORMSPREE_ENDPOINT=""

# CONTACT_WEBHOOK_URL: Optional webhook endpoint for forwarding contact submissions on the Express server
CONTACT_WEBHOOK_URL=""
